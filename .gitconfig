	email = 84910181+durgeshbg@users.noreply.github.com
    siginingKey = ~/.ssh/id_ed25519.pub

[core]
    editor = nvim
    excludesfile = /Users/durgesh/.gitignore_global
    pager = delta
[interactive]
    diffFilter = delta --color-only
[color]
